# Optional native Parix/TigerBeetle settlement plugin.
# Copy this file to .env and keep .env out of version control.
# Pass the non-secret profile separately, for example:
# --parix-profile src/zig/fixtures/parix-settlement-profile.example.json
# --ingress-auth-profile src/zig/fixtures/ingress-auth-profile.example.json
PARIX_BASE_URL=https://dev.parix.io
PARIX_DATABASE_ID=0e46f90e-c38b-487a-b9f9-630f7839cc3f

# Configure exactly one credential. Never pass credentials as CLI arguments.
PARIX_API_KEY=
# PARIX_BEARER_TOKEN=

# Authenticated ingress is enabled only with Parix settlement. The non-secret
# ingress profile names server environment variables such as these; each value
# is a path to an owner-only (0600) file containing one 32-byte key as 64
# lowercase hexadecimal characters, with an optional final LF. Do not put the
# key itself in this file.
EXCHANGE_INGRESS_TRADER_1001_KEY_FILE=/run/secrets/exchange-ingress-trader-1001.key
EXCHANGE_INGRESS_TRADER_1002_KEY_FILE=/run/secrets/exchange-ingress-trader-1002.key
EXCHANGE_INGRESS_OPERATOR_KEY_FILE=/run/secrets/exchange-ingress-operator.key

# Set this generic path only for an authenticated client invocation; leave it
# unset in the server-wide environment. Both client auth flags are also required.
# EXCHANGE_INGRESS_KEY_FILE=/run/secrets/exchange-ingress-client.key
